# Supabase cloud sync (OPTIONAL).
# Leave these unset to run the app in local-only mode (localStorage).
# To enable cross-device sync:
#   1. Create a free project at https://supabase.com
#   2. Run supabase-schema.sql in the Supabase SQL Editor
#   3. Project Settings → API → copy the Project URL and the "anon public" key below
#   4. In Supabase → Authentication → URL Configuration, add your site URL
#      (e.g. https://your-app.vercel.app and http://localhost:3000) to redirect URLs
#   5. Set these as Environment Variables in Vercel (and in .env.local for local dev), then redeploy.
# NOTE: the anon key is SAFE to expose in the browser — row-level security protects the data.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: live flight calendar prices for Travel (Travelpayouts Data API token).
# Free signup → https://www.travelpayouts.com/developers/api
# Without this, Travel uses a calibrated India route fare model + platform biases.
TRAVELPAYOUTS_TOKEN=
